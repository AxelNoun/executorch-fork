@@ -227,6 +227,20 @@ class MLXBackend final : public ::executorch::runtime::BackendInterface {
         handle->clear_cache_interval_ = spec.get();
       }
 
+      // Process-global MLX memory limits (see backend_options.h). Applied
+      // under mlx_global_mutex() so they cannot race another handle's
+      // submission; MB units because runtime specs carry a 32-bit int.
+      if (auto spec = context.get_runtime_spec<int>(kMemoryLimitMbKey);
+          spec.ok() && spec.get() > 0) {
+        ::mlx::core::set_memory_limit(
+            static_cast<size_t>(spec.get()) * (size_t{1} << 20));
+      }
+      if (auto spec = context.get_runtime_spec<int>(kCacheLimitMbKey);
+          spec.ok() && spec.get() >= 0) {
+        ::mlx::core::set_cache_limit(
+            static_cast<size_t>(spec.get()) * (size_t{1} << 20));
+      }
+
       // Bound the MLX Metal buffer cache. By default MLX sizes the cache to the
