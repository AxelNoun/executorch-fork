diff --git a/backends/mlx/runtime/backend_options.h b/backends/mlx/runtime/backend_options.h
index 2f96ce9..a81f47a 100644
--- a/backends/mlx/runtime/backend_options.h
+++ b/backends/mlx/runtime/backend_options.h
@@ -42,6 +42,24 @@ inline constexpr char kClearCacheIntervalKey[] = "clear_cache_interval";
 // errors otherwise). Saves one full mutable-buffer (KV-cache) copy per handle.
 inline constexpr char kSkipMutableBufferInitKey[] = "skip_mutable_buffer_init";
 
+// Per-model runtime-spec keys (int, mebibytes). Forwarded once, at init(), to
+// mlx::core::set_memory_limit() / set_cache_limit(). MLX allocates every
+// intermediate of a submitted graph at CPU encode speed and only frees it when
+// the GPU command buffer that reads it completes; the memory limit makes
+// eval_impl() wait for in-flight command buffers whenever active memory
+// exceeds it (mlx/transforms.cpp, MAX_ACTIVE_TASKS block), which bounds peak
+// footprint continuously rather than on average like clear_cache_interval.
+// MLX's active memory counts the wrapped constants too, so the limit has to
+// leave room for the weights of every loaded method; below that it degrades
+// to one command buffer in flight at a time rather than failing.
+// The cache limit bounds what MLX keeps after execute() instead of returning
+// it to the OS; 0 disables the cache entirely (MLX semantics). Both are
+// process-global MLX settings: the last handle to set them wins. Unset, or
+// memory_limit_mb <= 0, leaves the MLX defaults (1.5x the recommended working
+// set size on Metal, cache limit = memory limit) untouched.
+inline constexpr char kMemoryLimitMbKey[] = "memory_limit_mb";
+inline constexpr char kCacheLimitMbKey[] = "cache_limit_mb";
+
 } // namespace mlx
 } // namespace backends
 } // namespace executorch
