+// Logs the process memory counters the kernel keeps for jetsam and for
+// `/usr/bin/time -l`: physical footprint (anonymous + compressed + IOKit
+// mappings, which is where Metal buffers land) and its lifetime maximum. RSS
+// only counts pages the CPU touched, so it misses buffers written by the GPU;
+// see backends/mlx/_memprofile.py for the same distinction on the export side.
+static void log_memory_counters(const char* stage) {
+#ifdef __APPLE__
+  struct rusage_info_v4 ri;
+  if (proc_pid_rusage(
+          getpid(), RUSAGE_INFO_V4, reinterpret_cast<rusage_info_t*>(&ri)) !=
+      0) {
+    ET_LOG(Info, "[%s] proc_pid_rusage failed", stage);
+    return;
+  }
+  const double mib = 1024.0 * 1024.0;
+  ET_LOG(
+      Info,
+      "[%s] rss %.1f MiB, phys_footprint %.1f MiB, lifetime_max_phys_footprint %.1f MiB",
+      stage,
+      static_cast<double>(ri.ri_resident_size) / mib,
+      static_cast<double>(ri.ri_phys_footprint) / mib,
+      static_cast<double>(ri.ri_lifetime_max_phys_footprint) / mib);
+#else
+  (void)stage;
+#endif
+}
